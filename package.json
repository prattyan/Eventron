{
  "name": "eventron",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently \".venv\\Scripts\\python -m backend.main\" \"npm run dev --prefix frontend\"",
    "dev:all": "concurrently \".venv\\Scripts\\python -m backend.main\" \"npm run dev --prefix frontend\"",
    "start": ".venv\\Scripts\\python -m backend.main",
    "server": ".venv\\Scripts\\python -m backend.main",
    "frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "install:frontend": "cd frontend && npm install",
    "install:backend": ".venv\\Scripts\\pip install -r backend\\requirements.txt",
    "install:all": "npm run install:frontend && npm run install:backend",
    "cache:clear": "curl -X POST http://localhost:5005/api/cache/clear",
    "cache:stats": "curl http://localhost:5005/api/cache/stats"
  },
  "dependencies": {
    "concurrently": "^9.2.1"
  }
}